# Copy to server/.env (git-ignored) or export in your shell before `docker compose up -d`.
# Local Postgres password for the demo database (any value; never commit the real file).
RAAGA_DB_PASSWORD=
# Grading: one of these. Without either, reviews are recorded as failed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Firebase project whose ID tokens the API accepts; set FIREBASE_AUTH_EMULATOR_HOST only with the auth emulator.
FIREBASE_PROJECT_ID=demo-raaga
FIREBASE_AUTH_EMULATOR_HOST=

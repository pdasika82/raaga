# Copy to server/.env. Never put provider secrets in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: only used for exercises with expected lyrics. First notes uses swaras.
DEEPGRAM_API_KEY=
# live requires a working API key; rules is explicitly labeled non-AI feedback.
FEEDBACK_MODE=live

# Host defaults for running the API/worker outside Docker against demo services.
DATABASE_URL=postgres://raaga:raaga-local-only@127.0.0.1:55432/raaga
REDIS_URL=redis://127.0.0.1:56379
FIREBASE_PROJECT_ID=demo-raaga
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
DEMO_MODE=true
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
MAILPIT_URL=http://127.0.0.1:58025
CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
PORT=8787
HOST=127.0.0.1
UPLOAD_DIR=./data/uploads
# Local demo only: none | skip-parent. Never enable on a real environment.
DEMO_NOTIFICATION_FAULT=none

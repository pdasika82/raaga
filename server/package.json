{
  "name": "raaga-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "worker": "node --import tsx src/worker.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --import tsx scripts/migrate.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "fixtures": "node --import tsx scripts/fixtures.ts",
    "demo:check": "node --import tsx scripts/check-demo.ts",
    "demo:retry": "node --import tsx scripts/retry-notifications.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "bullmq": "^5.61.0",
    "fastify": "^5.6.0",
    "firebase-admin": "^13.5.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^7.0.9",
    "openai": "^7.47.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

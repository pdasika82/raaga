# Firebase Console > Project settings > Your apps > Web app configuration.
# These are public client identifiers, not Admin SDK / service-account secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional, local development only. Never set this in a production deployment.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Enables saved, server-side Raaga reviews. Provider keys belong on the server.
# VITE_GRADING_API_URL=http://127.0.0.1:8787
